{
	"name": "kapten-order-parcel-tracking-audit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run build && node --watch dist/server/main.js",
		"build": "node build.mjs",
		"start": "node dist/server/main.js",
		"typecheck": "tsgo --noEmit",
		"lint": "oxlint src tests",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test": "vitest run",
		"test:browser": "playwright test",
		"benchmark": "tsx tests/benchmark.ts"
	},
	"dependencies": {
		"csv-parse": "7.0.2",
		"effect": "3.22.2",
		"express": "5.2.1",
		"jose": "6.2.12",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"read-excel-file": "9.3.10"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/express": "5.0.6",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/supertest": "7.2.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"rolldown": "1.2.9",
		"supertest": "7.2.2",
		"tsx": "4.23.13",
		"vitest": "4.1.11",
		"write-excel-file": "4.1.1"
	},
	"engines": {
		"node": ">=24"
	}
}
